{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/ganderson",
      "destination": "/ganderson/index.html"
    },
    {
      "source": "/ganderson/",
      "destination": "/ganderson/index.html"
    },
    {
      "source": "/ganderson/users",
      "destination": "/ganderson/users.html"
    },
    {
      "source": "/ganderson/records",
      "destination": "/ganderson/records.html"
    }
  ],
  "headers": [
    {
      "source": "/ganderson/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
