# Server only. Supabase Connect > Transaction pooler URI, with DB password.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres
# Exact public origin, no trailing slash. Use localhost only during development.
APP_ORIGIN=http://localhost:3000
# Optional if the DB certificate needs Supabase's downloaded CA certificate.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
